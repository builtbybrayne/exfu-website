---
import { toolFamilies, marketplace } from '../data/tools';
---

<section id="tools" class="tools-section section" aria-labelledby="tools-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Already using ExFu?</p><h2 id="tools-title">
          Your tools live here, too.
        </h2>
      </div><a class="text-link" href="/tools/">Find your tools & documentation ↗</a>
    </div><div class="tool-grid">
      {
        toolFamilies.map((tool) => (
          <article>
            <>
              <h3>
                <a href={marketplace}>
                  {tool.name} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{tool.description}</p>
            </>
          </article>
        ))
      }
      <article class="more-tools">
        <h3><a href={marketplace}>And more ↗</a></h3><p>
          A selection of the tools I build. Find the full catalogue and latest additions in the
          marketplace.
        </p>
      </article>
    </div><p class="tools-footnote">
      Public agent tooling. Browse the source, read the docs or get help with your setup.
    </p>
    <div class="home-install">
      <h3>Your agent, with more context.</h3><p>
        The Agent Library helps your agent keep track of your work, preferences and ongoing
        projects. The setup guide walks you through getting started.
      </p><a class="text-link" href="/tools/#setup">Explore the tools & get set up ↗</a>
    </div>
  </div>
</section>
