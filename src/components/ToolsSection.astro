---
import CopyBlock from './CopyBlock.astro';
import { toolFamilies, marketplace, installLibrary } from '../data/tools';
---

<section id="tools" class="tools-section section" aria-labelledby="tools-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Already using ExFu?</p><h2 id="tools-title">
          Your tools live here, too.
        </h2>
      </div><a class="text-link" href="/tools/">Find your tools & documentation ↗</a>
    </div><div class="tool-grid">
      {
        toolFamilies.map((tool) => (
          <article>
            <>
              <h3>
                <a href={marketplace}>
                  {tool.name} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{tool.description}</p>
            </>
          </article>
        ))
      }
    </div><p class="tools-footnote">
      Public agent tooling. Browse the source, read the docs or get help with your setup.
    </p>
    <div class="home-install">
      <h3>Start with the Agent Library.</h3><p>
        Already using Claude Code? Paste this into your terminal.
      </p><CopyBlock text={installLibrary} label="Copy Agent Library install command" /><a
        class="text-link"
        href="/tools/#setup">New to plugins? Follow the setup guide ↗</a
      >
    </div>
  </div>
</section>
