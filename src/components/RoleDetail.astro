---
import { roles } from '../data/roles';
const { role } = Astro.props as { role: (typeof roles)[number] };
---

<div class="role-detail-content">
  <header>
    <img
      src={`/images/avatars/${role.id}-2.webp`}
      alt=""
      width="140"
      height="140"
      loading="lazy"
    /><div><p class="eyebrow red">{role.name}</p><h3>{role.question}</h3></div>
  </header>
  <p>{role.intro}</p>
  <ul>{role.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
  <div class="role-reassurance"><h4>{role.concern}</h4><p>{role.reassurance}</p></div>
  <a class="text-link" href={role.href}>Explore how we could work together ↗</a>
</div>
