---
import RoleDetail from './RoleDetail.astro';
import { roles } from '../data/roles';
---

<section class="people-section audience-section section" aria-labelledby="people-title">
  <div class="wrap audience-heading">
    <div>
      <h2 id="people-title">Different clients.<br />Familiar sticking points</h2><p>
        You might be leading the change, backing a team, or trying to get on top of your own work.
      </p>
    </div><div class="ring-controls" hidden>
      <p id="ring-hint">Drag or swipe the cards. Use the arrows to explore.</p><div>
        <button type="button" data-ring-prev aria-label="Show previous avatar">←</button><button
          type="button"
          data-ring-next
          aria-label="Show next avatar">→</button
        ><button type="button" data-ring-pause aria-pressed="false">Pause movement</button>
      </div>
    </div>
  </div>
  <div
    class="role-ring"
    tabindex="0"
    role="group"
    aria-label="Illustrated client situations"
    aria-describedby="ring-hint"
  >
    {
      roles.map((role, i) => (
        <div class="role-slot" data-index={i}>
          <a class="role-card" href={`#role-${role.id}`} data-role={role.id} draggable="false">
            <>
              <span class="portrait-stack">
                {[2, 1, 3].map((variant, index) => (
                  <img
                    class:list={{ 'is-current': index === 0 }}
                    src={`/images/avatars/${role.id}${variant === 1 ? '' : `-${variant}`}.webp`}
                    width="480"
                    height="480"
                    alt=""
                    loading="lazy"
                    draggable="false"
                  />
                ))}
              </span>
              <span class="role-name">{role.name}</span>
              <span class="role-question">{role.question}</span>
            </>
          </a>
        </div>
      ))
    }
  </div>
  <div class="wrap ring-bottom">
    <p>Illustrated situations, not client portraits. Choose whatever feels relevant.</p><button
      type="button"
      class="text-link"
      id="show-roles"
      aria-expanded="true"
      aria-controls="role-directory"
      hidden>Show all roles</button
    >
  </div>
  <div id="role-directory" class="wrap role-details-grid">
    {
      roles.map((role) => (
        <article id={`role-${role.id}`} class="role-detail">
          <RoleDetail role={role} />
        </article>
      ))
    }
  </div>
  <dialog id="role-popover" aria-labelledby="popover-heading">
    <button type="button" class="popover-close" aria-label="Close persona details">Close ×</button
    ><div class="popover-content"></div>
  </dialog>
  <script src="../scripts/role-details.ts"></script>
  <script src="../scripts/avatar-ring.ts"></script>
</section>
