---
import HeroMotionReview from '../components/HeroMotionReview.astro';
import AgentIntro from '../components/AgentIntro.astro';
import Layout from '../layouts/Layout.astro';
import Invitation from '../components/Invitation.astro';
import RecentWork from '../components/RecentWork.astro';
import AvatarRing from '../components/AvatarRing.astro';
import ToolsSection from '../components/ToolsSection.astro';
---

<Layout
  title="Experienced help to make AI work for you"
  description="Fractional AI support, practical delivery and personal agent setup with Alastair Brayne. Find worthwhile opportunities, make the case and build with your team."
>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow red">Fractional AI support & delivery</p>
        <h1><span>You see the potential.</span> <span>Let’s make it work.</span></h1>
        <p class="hero-intro">
          Work out where AI can make a difference in your business. Get the backing to make the
          case, build it, and bring your team with you.
        </p>
        <a class="button" href="/enquire/?quiz=1"
          >Find your starting point <span aria-hidden="true">↗</span></a
        >
        <a class="hero-secondary" href="/enquire/">Have a brief? Let’s talk.</a>
        <p class="availability">Remote engagements. Bristol in person by arrangement.</p>
      </div>
      <div class="paper-scene" aria-label="From an opportunity to work your team can own">
        <span class="paper-orbit" aria-hidden="true"></span>

        <ol class="paper-stack">
          <li class="paper paper-one">
            <span class="paper-number" aria-hidden="true">1</span><span
              >Find the AI opportunity</span
            ><span class="paper-detail">Start with what matters.</span>
          </li>
          <li class="paper paper-two">
            <span class="paper-number" aria-hidden="true">2</span><span>Make the case</span><span
              class="paper-detail">Give the idea some evidence.</span
            >
          </li>
          <li class="paper paper-three">
            <span class="paper-number" aria-hidden="true">3</span><span
              >Build and hand&nbsp;over</span
            ><span class="paper-detail">Make it yours to take forward.</span>
          </li>
        </ol>
      </div>
    </div>
  </section>
  <AgentIntro />
  <HeroMotionReview />
  <section class="section" id="work-together">
    <div class="wrap offer-grid">
      <div>
        <p class="eyebrow">Someone in your corner</p><h2>
          Fractional support for the person moving AI forward.
        </h2><p>
          I work alongside founders and CEOs, CTOs and internal advocates to assess opportunities,
          make the case to leadership, and deliver agents and workflows your team can own.
        </p><p>
          That could mean AI-enabled revenue channels, customer research, shared business knowledge,
          integrations, internal tools or a customer-facing agent. We choose the work around a
          business goal.
        </p><a class="button" href="/fractional-support/"
          >Explore fractional support <span aria-hidden="true">↗</span></a
        >
      </div>
      <aside class="offer-note" aria-label="Ways to work together">
        <div>
          <span class="note-symbol" aria-hidden="true"
            ><svg
              viewBox="0 0 32 34"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M25 11a10 10 0 0 0-17-2L5 12m0-7v7h7M7 21a10 10 0 0 0 17 2l3-3m0 7v-7h-7"
              ></path></svg
            ></span
          ><h3>Ongoing support</h3><p>Experienced help alongside you as the work develops.</p>
        </div>
        <div>
          <span class="note-symbol" aria-hidden="true"
            ><svg
              viewBox="0 0 32 34"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="7" y="5" width="20" height="24" rx="2"></rect><path
                d="m11 13 2 2 4-4m-6 11 2 2 4-4m3-7h3m-3 9h3"></path></svg
            ></span
          ><h3>Defined projects</h3><p>A specific opportunity, with a scope we agree together.</p>
        </div>
        <div>
          <span class="note-symbol" aria-hidden="true"
            ><svg
              viewBox="0 0 32 34"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="5" width="17" height="12" rx="2"></rect><rect
                x="17"
                y="20"
                width="12"
                height="9"
                rx="1"></rect><path d="M8 21h7m-4-4v4m12-11h4v6M8 25h5"></path></svg
            ></span
          ><h3>Remote collaboration</h3><p>
            Work together wherever you are. Bristol sessions by arrangement.
          </p>
        </div>
        <p class="note-signoff">Practical AI. Real work.</p>
      </aside>
    </div>
  </section>
  <AvatarRing />
  <Invitation />
  <RecentWork />
  <section class="about-strip">
    <div class="wrap about-strip-inner">
      <div>
        <p class="eyebrow">The person you’ll work with</p><h2>Alastair Brayne</h2><p>
          20+ years in software. AI founder. Trained psychotherapist.
        </p>
      </div><a class="text-link" href="/about/"
        >People, technology and the work between them <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <ToolsSection />
  <section class="definitions section" aria-label="What ExFu means">
    <div class="wrap definitions-grid">
      <div>
        <img
          src="/images/exfu-logo-dark.png"
          alt="ExFu"
          width="2211"
          height="917"
          loading="lazy"
        /><p class="pronunciation">/ˈeks fʊː/</p><p>A name with a few things on its mind.</p>
      </div><dl>
        <div>
          <dt>Execution fu <span>(as in Kung Fu)</span></dt><dd>
            The art of making AI work for you.
          </dd>
        </div><div>
          <dt>Executive function</dt><dd>Support for planning and following through.</dd>
        </div><div>
          <dt>Executive, functioning</dt><dd>More headspace for the person everyone turns to.</dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>
