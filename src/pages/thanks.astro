---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thank you for your enquiry"
  description="Thank you for getting in touch with Alastair at ExFu."
  noindex
>
  <section class="section utility-page">
    <div class="wrap">
      <p class="eyebrow red">Thank you</p><h1>A good place<br />to start.</h1><p class="lead">
        Your enquiry has been submitted. I’ll read it and reply personally.
      </p><p>
        If you need to add anything, email <a
          href="mailto:al@exfu.ai"
          target="_blank"
          rel="noopener noreferrer">al@exfu.ai</a
        >.
      </p><a class="button" href="/">Back to ExFu <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
